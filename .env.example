# Copy to .env (no extension) and fill in. .env is git-ignored.

# NovelAI persistent API token: novelai.net -> User Settings -> Account -> Get Persistent API Token
NAI_API_KEY=pst-...

# Optional: where images, thumbs and the DB live (default ./data)
# NAI_DATA_DIR=

# Optional, for reference images: Gelbooru -> My Account -> Options -> API Access Credentials.
# Either both values, or paste the whole "&api_key=...&user_id=..." string into GELBOORU_API_KEY.
# GELBOORU_API_KEY=
# GELBOORU_USER_ID=
